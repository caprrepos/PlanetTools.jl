    given-names: "Jan P."
    orcid: "https://orcid.org/0000-0003-3634-8941"
    email: "jan.p.perlwitz@caprllc.com"
    affiliation: "Climate, Aerosol, and Pollution Research, LLC"
version: "0.2.3"
date-released: "2026-11-02"
license: MIT
repository-code: "https://github.com/caprrepos/PlanetTools.jl"
url: "https://caprrepos.github.io/PlanetTools.jl/stable/"
